# syntax=docker/dockerfile:1
#
# The web client (`apps/web`). Build from the REPO ROOT:
#
#   docker build -f apps/web/Dockerfile -t solo-starter-web .

ARG NODE_VERSION=24
ARG PNPM_VERSION=10.30.3

# ============================================================
# Base stage: shared tooling
# ============================================================
FROM node:${NODE_VERSION}-alpine AS base

# Enable corepack for pnpm
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Install libc6-compat for native modules
RUN apk add --no-cache libc6-compat

WORKDIR /app

# ============================================================
# Dependencies stage: install workspace dependencies
# ============================================================
FROM base AS deps

# Copy workspace config. The repo's .npmrc carries the settings the lockfile
# was written with; the hoisted linker is added for the image only, so
# context-bearing packages (@clerk/*, next-themes, @tanstack/react-query)
# resolve to one physical copy (see apps/web/next.config.ts).
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
RUN echo "node-linker=hoisted" >> .npmrc

# Copy only the package.json files needed for the web client + its workspace deps
COPY apps/web/package.json ./apps/web/
COPY packages/ui/package.json ./packages/ui/

RUN pnpm install --frozen-lockfile

# ============================================================
# Builder stage: build @app/ui then apps/web
# ============================================================
FROM base AS builder

WORKDIR /app

# Copy the install from the deps stage (hoisted: one root node_modules, plus
# per-package folders only where a version could not be hoisted).
COPY --from=deps /app ./

# Copy the sources this image builds
COPY packages/ui/ ./packages/ui/
COPY apps/web/ ./apps/web/

# Build-time env vars for Next.js NEXT_PUBLIC_* baking
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL
ARG NEXT_PUBLIC_CLERK_SIGN_UP_URL
ARG NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
ARG NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_SUPPORT_EMAIL
# KIT CARD: remove this line. 0 builds without the application kit card and the /upgrade page.
ARG NEXT_PUBLIC_SHOW_KIT_CARD

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build @app/ui first (turbo handles dependency order in
# CI; this explicit step ensures the Docker layer works standalone)
WORKDIR /app/packages/ui
RUN pnpm run build

# Build the Next.js app
WORKDIR /app/apps/web
RUN pnpm run build

# ============================================================
# Runner stage: minimal production image
# ============================================================
FROM node:${NODE_VERSION}-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy Next.js standalone output
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

# Copy static assets
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

# Copy public folder
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs

WORKDIR /app/apps/web

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is generated by Next.js standalone output
CMD ["node", "server.js"]
