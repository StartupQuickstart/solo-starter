# Web client (apps/web): environment variable reference
# Copy this file to .env.local for local development.
# NEVER commit a populated .env.local to source control.
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at build time
# and is therefore public. The app's own are validated in src/config/app.config.ts.

# ── Product identity ───────────────────────────────────────────────────────────
# Shown in page titles and headings. Default: "Your App".
NEXT_PUBLIC_APP_NAME=
# Where people reach a human. Default: support@example.com.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── The application kit card ───────────────────────────────────────────────────
# KIT CARD: this starter shows a card at the foot of its sidebar, and a page at
# /upgrade, about the paid application kit it is the free sibling of. That is
# promotion for another product, and the people who use your app would see it.
# Set this to 0 to build without both (/upgrade then answers 404). Unset, empty
# or 1 shows them; any other value fails the build. To delete them for good,
# see src/features/kit-upgrade.
NEXT_PUBLIC_SHOW_KIT_CARD=

# ── Clerk authentication───────────────────────────────────────────────────────
# Publishable key (safe in the browser; inlined into the bundle at build time).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-side secret key, read by the Clerk request hook. Never expose it to the browser.
CLERK_SECRET_KEY=
# Sign in and sign up on this app's own pages (src/app/sign-in, src/app/sign-up),
# as Clerk's custom-page guides set them. Where to land afterwards, when no
# other page was asked for: Home.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── API ────────────────────────────────────────────────────────────────────────
# Origin of the API (apps/api). Default: http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000
