{
  "name": "@app/api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate --schema prisma/ && tsc && tsc-alias",
    "dev": "tsx watch --ignore 'node_modules/**' --ignore 'dist/**' src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src scripts tests",
    "lint:fix": "eslint src scripts tests --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:all": "vitest run && vitest run --config vitest.int.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema prisma/",
    "db:migrate": "prisma migrate dev --schema prisma/",
    "db:migrate:prod": "node scripts/migrate-deploy.mjs",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/",
    "db:reset": "prisma migrate reset --force --schema prisma/"
  },
  "dependencies": {
    "@app/backend": "workspace:*",
    "@clerk/express": "^2.1.78",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "prisma": "^7.10.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.4",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
