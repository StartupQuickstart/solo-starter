# API (apps/api): environment variable reference
# Copy this file to .env and fill in the values for local development.
# NEVER commit a populated .env to source control.
#
# The API validates these at boot (src/config/app.config.ts) and refuses to
# start, naming the variable, when one is missing or malformed.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Port the API listens on (4000 locally; the host sets it in production).
PORT=4000
HOST=localhost
# Winston log level (default: debug in development, info in production).
LOG_LEVEL=info
# Product name, used in logs. Default: "Your App".
APP_NAME=
# Reverse-proxy hops in front of the API. 0 locally. Set 1 behind one load
# balancer (Railway, Render, Fly, a single nginx). Rate limits key on the
# client address this yields.
TRUST_PROXY=0

# ── Web client ─────────────────────────────────────────────────────────────────
# Origin of the web client. Stripe returns customers here after Checkout and
# the Billing Portal. Required in production.
APP_URL=http://localhost:3000
# Comma-separated origins allowed by CORS. Defaults to APP_URL. A wildcard is
# refused: the API sends credentials. Required in production.
CORS_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
# Local Postgres comes from `pnpm db:up` (apps/api/docker-compose.yml, host
# port 5442). These are the local container's throwaway credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/app
# Optional. A direct connection for migrations, when DATABASE_URL points at a
# pooler. The Prisma CLI uses it in place of DATABASE_URL (prisma.config.ts).
DIRECT_URL=postgresql://postgres:postgres@localhost:5442/app
# Integration tests only (`pnpm test:int`): a separate database they may truncate.
# Unset = the database-backed integration tests are skipped.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5442/app_test
# The most connections the API's pool opens (default 10).
DATABASE_MAX_CONNECTIONS=10

# ── Clerk ──────────────────────────────────────────────────────────────────────
# Server-side secret key. Never expose it to the browser.
CLERK_SECRET_KEY=
# Publishable key (public by design).
CLERK_PUBLISHABLE_KEY=
# Signing secret of the Clerk webhook endpoint POST /api/webhooks/clerk.
# Subscribe the endpoint to user.created, user.updated and user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Stripe (optional) ──────────────────────────────────────────────────────────
# Set all three or none. Without them billing is off: GET /billing reports
# `billingEnabled: false`, Checkout and the portal answer 503
# BILLING_NOT_CONFIGURED, nobody is subscribed and the gated example (the
# notes export) stays locked. Everything else works.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint POST /api/webhooks/stripe.
# Subscribe the endpoint to checkout.session.completed and
# customer.subscription.created, .updated and .deleted.
STRIPE_WEBHOOK_SECRET=
# The price of the one plan: the id of a recurring price in Stripe (it starts
# with "price_"). Checkout sells it; the billing page shows its amount.
STRIPE_PRICE_ID=
# What the plan is called on the billing page. Default: "Pro".
BILLING_PLAN_NAME=

# ── Observability (optional) ───────────────────────────────────────────────────
# Better Stack (Logtail) log stream. The Winston transport activates when the
# source token is set.
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=
