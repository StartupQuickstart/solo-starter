// Prisma schema entry point.
// Model definitions live in prisma/models/*.prisma.
// Run `pnpm --filter @app/api db:generate` to emit the client.
//
// All models live in the Postgres `app` schema. Ids are generated by the
// database (`app.nanoid('<prefix>_')`, created in the init migration), columns
// are snake_case, and rows are soft-deleted through `deleted_at`.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// The connection is not configured here. The CLI reads it from
// prisma.config.ts; the running API passes it to the driver adapter
// (src/lib/database/prisma-client.ts).
datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}
